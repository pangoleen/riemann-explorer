{
  "name": "riemann-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:visual": "tsx scripts/visual-test.ts",
    "pipeline": "bash pipeline/run_all.sh",
    "capture": "tsx scripts/capture.ts",
    "capture:4x5": "tsx scripts/capture.ts --aspect=4x5"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.181.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
